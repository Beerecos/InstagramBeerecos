{
  "permissions": {
    "allow": ["Bash(npm run video *)", "Bash(npm run video:validate *)", "Bash(npm run video:build *)", "Bash(ffprobe *)"],
    "deny": ["Read(**/.env)", "Read(**/.env.local)", "Read(**/.env.*.local)", "Edit(**/.env)", "Edit(**/.env.local)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
