  },
  "production_modes": {
    "studio": {
      "label": "Importer ma vidéo",
      "voice_source": "source_video",
      "presenter_source": "source_video"
    },
    "ai": {
      "label": "Générer avec l’IA",
      "voice_source": "approved_generated_audio",
      "presenter_source": "generated_or_licensed_media"
    },
    "hybrid": {
      "label": "Combiner ma vidéo et l’IA",
      "voice_source": "source_video_or_approved_generated_audio",
      "presenter_source": "mixed"
    }
  },
  "visual_rules": {
    "hook_visible_from_first_frame": true,
    "main_overlay_max_words": 8,
    "main_overlay_target_words": [
      2,
      6
    ],
    "main_overlay_max_lines": 2,
    "max_simultaneous_main_overlays": 1,
    "allowed_overlay_modes": [
      "behind_subject",
      "tab",
      "none"
    ],
    "behind_subject_requires_temporal_person_mask": true,
    "behind_subject_fallback": "tab",
    "behind_subject_readability_check": "Si le masque cache un mot essentiel ou si le détourage est instable, déplacer le texte ou passer en onglet.",
    "layer_order": [
      "base_video",
      "behind_subject_text",
      "person_foreground_mask",
      "tab_overlay",
      "subtitles",
      "optional_brand_mark"
    ],
    "safe_area": {
      "kind": "configurable_editorial_guides",
      "top_inset_ratio": 0.1,
      "bottom_inset_ratio": 0.2,
      "left_inset_ratio": 0.08,
      "right_inset_ratio": 0.16,
      "validation": "Repères initiaux à contrôler dans l’aperçu Instagram ; ils ne constituent pas des marges officielles universelles."
    },
    "motion": "Révélations sobres et recadrages légers aux changements d’idée ; aucun changement de plan imposé à chaque ligne."
  },
  "captions": {
    "source": "final_edited_audio",
    "placement": "bottom_center_inside_safe_area",
    "max_lines": 2,
    "target_words_per_cue": [
      3,
      7
    ],
    "cue_policy": "Les groupes suivent les mots prononcés et la lisibilité ; ce nombre de mots est un repère éditorial, pas une durée fixe.",
    "burn_in": true,
    "export_sidecars": [
      "srt",
      "vtt"
    ],
    "word_timestamps_required_for_word_highlight": true,
    "allow_unmeasured_cues": false,
    "actual_transcript_overrides_prompt_for_captions": true
  },
  "audio": {
    "voice_priority": true,
    "music_optional": true,
    "music_asset_ref": null,
    "music_ducking_when_voice": true,
    "pronunciation_review": [
      "BeeRecos",
      "BeeSchool",
      "BeeLive",
      "BeeToBee",
      "BeeCamp",
      "R zéro",
      "R un",
      "R deux"
    ]
  },
  "timeline": {
    "unit": "milliseconds",
    "reference": "final_output_timeline",
    "planning_method": "Répartition proportionnelle au nombre de mots dans 48 secondes de parole, suivies de 2 secondes de carte de fin.",
    "planned_is_not_measured": true,
    "actual_alignment_source": "final_edited_audio",
    "source_clip_time_is_separate_from_output_time": true,
    "end_is_exclusive": true
  },
  "cta": {
    "goal": "club_visit",
    "one_keyword_per_reel": true,
    "allowed_display_keywords": [
      "RÉSEAU",
      "BUSINESS",
      "CLUB",
      "INVITATION",
      "VISITE",
      "FORMATION",
      "DIGITALISATION"
    ],
    "matching": "Unicode sans accents, minuscules, mots entiers, limité au post concerné ; pas de correspondance par sous-chaîne.",
    "deduplicate_by": [
      "platform",
      "account_id",
      "comment_id"
    ],
    "repeat_contact_policy": "Une invitation par personne et par Reel tant que la conversation n’a pas repris ; éviter les doublons lors des retries.",
    "landing_route_ref": null,
    "landing_required_fields": [
      "club_id",
      "meeting_id",
      "invited_by_or_referral"
    ],
    "attribution_rule": "Distinguer la source du Reel du membre invitant ; vérifier le jeton de parrainage côté serveur et conserver la paternité déjà enregistrée."
  },
  "workflow": {
    "editorial_states": [
      "draft",
      "needs_review",
      "approved"
    ],
    "media_states": [
      "missing",
      "processing",
      "ready",
      "failed"
    ],
    "render_states": [
      "not_started",
      "rendering",
      "preview_ready",
      "final_ready",
      "failed"
    ],
    "publication_states": [
      "not_scheduled",
      "scheduled",
      "publishing",
      "published",
      "failed",
      "needs_reconciliation"
    ],
    "publish_requires": [
      "approved_current_revision",
      "valid_final_render",
      "working_cta_route",
      "provider_authorization",
      "registered_schedule_or_publish_action"
    ],
    "default_approval": "manual",
    "publish_idempotency_scope": [
      "platform",
      "account_id",
      "reel_id",
      "revision"
    ],
    "unknown_publish_result": "Rechercher le résultat auprès du fournisseur avant de republier ; ne pas relancer à l’aveugle.",
    "display_timezone": "Europe/Paris",
    "persist_schedule_as": "UTC instant with original display timezone",
    "revision_rules": {
      "script_or_source_audio_change": "Invalider transcription, alignement, rendu et validation de la version courante.",
      "cut_or_speed_change": "Recalculer les timecodes sur la bande son finale et invalider le rendu approuvé.",
      "overlay_or_brand_change": "Conserver l’audio lorsque possible, recalculer le rendu et demander une nouvelle validation.",
      "published_item_change": "Créer une nouvelle révision ; ne pas présenter l’ancienne publication comme mise à jour."
    }
  },
  "interface": {
