    "height_px": 1920,
    "aspect_ratio": "9:16",
    "fps": 30,
    "export_container": "mp4",
    "video_codec": "h264",
    "audio_codec": "aac",
    "min_duration_ms": 35000,
    "max_duration_ms": 60000,
    "target_duration_ms": 50000,
    "closing_card_duration_ms": 2000,
    "duration_rule": "Durée éditoriale totale BeeRecos, carte de fin et CTA compris ; contrôler le fichier exporté."
  },
  "brand": {
    "name": "BeeRecos",
    "primary_color": "#2851FF",
    "dark_color": "#111111",
    "light_color": "#FFFFFF",
    "logo_asset_ref": null,
    "heading_font_asset_ref": null,
    "subtitle_font_asset_ref": null,
    "baseline": "#MonReseauCestTonReseau",
    "baseline_color": "#2851FF",
    "baseline_style": "handwritten",
    "closing_card_asset_ref": null,
