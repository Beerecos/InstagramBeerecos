# =============================================================================
# BeeMarketing — variables d'environnement
# Copier en .env.local (local) ou saisir dans Vercel → Settings → Environment Variables.
# Aucune valeur réelle ici. Validation au démarrage : src/lib/env/schema.ts
# =============================================================================

# --- CLIENT (exposées au navigateur : valeurs publiques uniquement) -----------
# URL du projet Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Clé "publishable" Supabase (sb_publishable_…) — protégée par la RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL publique de l'application (liens magiques, callbacks)
NEXT_PUBLIC_APP_URL=

# --- SERVEUR UNIQUEMENT (secrets) ----------------------------------------------
# Clé secrète Supabase (sb_secret_…) : workflows et webhooks. Ne jamais exposer.
SUPABASE_SECRET_KEY=
# 1 = interface de démonstration sans données (interdit si Supabase est configuré)
BEEMARKETING_DEMO_MODE=

# Intelligence (phase 2) : une des deux
# Secret des tâches planifiées (Watchdog) — générer : openssl rand -hex 32
CRON_SECRET=

ANTHROPIC_API_KEY=
# Modèle des agents (défaut : claude-opus-5-5)
ANTHROPIC_MODEL=
AI_GATEWAY_API_KEY=

# Instagram — API officielle Meta, sans abonnement (publication, statistiques, commentaires → DM)
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_APP_SECRET=
IG_VERIFY_TOKEN=
# IG_GRAPH_HOST=graph.instagram.com
# IG_API_VERSION=v26.0

# LinkedIn — API officielle (application créée sur linkedin.com/developers)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Page entreprise BeeRecos (après validation « Community Management API »), ex. urn:li:organization:123456
LINKEDIN_ORGANIZATION_URN=
# Version d'API au format AAAAMM (défaut : dernière version testée)
LINKEDIN_API_VERSION=

# Génération vidéo (phase 3)
GOOGLE_VEO_API_KEY=
RUNWAY_API_KEY=
# Voix off IA (optionnel)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Import Google Drive (phase 2)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# --- CLI historique automation/ (Supabase REST, stockage des vidéos) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=reels
