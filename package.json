{
  "name": "beemarketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && npm run test:legacy",
    "test:legacy": "node --test \"automation/test/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "ig": "node automation/bin/ig.mjs",
    "voice": "node automation/bin/voice.mjs",
    "reel:render": "node automation/bin/render-reel.mjs",
    "video": "node automation/bin/edit-video.mjs",
    "video:validate": "node automation/bin/edit-video.mjs validate",
    "video:build": "node automation/bin/edit-video.mjs build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hyperframes/player": "0.8.126",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
